{
  "name": "omp-top",
  "version": "0.6.0",
  "releaseChannel": "stable",
  "description": "Zero-dependency terminal monitor for Oh My Pi (OMP) stats, cache efficiency, and provider quota.",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun src/main.mjs",
    "test": "bun test/run.mjs",
    "test:node": "node test/run.mjs",
    "check": "bun build src/*.mjs --target=bun --outdir=/tmp/omp-top-build"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": ["omp", "oh-my-pi", "terminal", "tui", "cache", "quota", "monitoring"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nqt9002/omp-top.git"
  },
  "homepage": "https://github.com/nqt9002/omp-top#readme",
  "bugs": {
    "url": "https://github.com/nqt9002/omp-top/issues"
  },
  "license": "MIT",
  "private": true
}
